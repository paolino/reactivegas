+const VT_THRESHOLDS = {
+  legacyThreshold: n => Math.floor((n + 1) / 2),
+  zeroThreshold: () => 0,
+};
+const VT_THRESHOLD_NAME = 'legacyThreshold';
+const vtTheta = VT_THRESHOLDS[VT_THRESHOLD_NAME];
