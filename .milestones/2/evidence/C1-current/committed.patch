+    case 'correctPledge': {
+      const col = state.collections.find(x => x.id === p.c);
+      const cur = (col.accepted.find(q => q.user === p.user) || { amount: 0 }).amount;
+      const mx = cur + Math.max(0, bal(state.conti, p.user));
+      return { min: 0, max: mx, val: cur, what: `impegno di ${nm(p.user)}: ora ${eur(cur)}` };
+    }
