+      const n = members.length;
+      need(isResponsabile(view, e.author), AUTH(e.author));
+      need(0 < e.w, g('0 < w', `la quota deve essere positiva (${e.w})`));
+      need(comuneBal(s) >= n * e.w,
+        g('comuneBal s ≥ n * w',
+          `comune insufficiente: ${comuneBal(s)} < ${n * e.w}`));
