+function eur(n) {
+  const v = Number(n);
+  if (!Number.isFinite(v)) return '— €';
+  return (v < 0 ? '−' : '') + String(Math.abs(v)) + ' €';
+}
+function signedEur(n) {
+  const v = Number(n);
+  if (!Number.isFinite(v)) return '— €';
+  if (v > 0) return '+' + String(v) + ' €';
+  if (v < 0) return '−' + String(Math.abs(v)) + ' €';
+  return '0 €';
