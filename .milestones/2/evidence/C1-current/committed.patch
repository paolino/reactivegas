+function diagVocabLint() {
+  const banned = /colletta|\bpledge\b/i;                                   // DIAGLINT-ALLOW
+  // token-precise: strip the allowed machine-identifier shapes from each
+  // line FIRST, then test what remains — prose sharing a line with a legal
+  // identifier is still caught
+  const stripAllowed = l => l
+    .replace(/data-pledge[-a-z]*/g, '')      // row selector attributes       DIAGLINT-ALLOW
+    .replace(/data-task="pledge"/g, '')      // task selector (machine tag)   DIAGLINT-ALLOW
+    .replace(/'pledge'|"pledge"/g, '')       // exact view/tag token compare  DIAGLINT-ALLOW
+    .replace(/\.pledge\b/g, '');             // dotted machine provenance     DIAGLINT-ALLOW
+  return (selftest.toString() + '\n' + diagVocabLint.toString())
+    .split('\n')
+    .filter(l => !/DIAGLINT-ALLOW/.test(l) && !/^\s*\/\//.test(l))
+    .filter(l => banned.test(stripAllowed(l)));
