+  collections: s.collections.map(c => ({ id: c.id, referente: c.referente,
+    permitted: c.permitted,
+    accepted: c.accepted.map(p => ({ user: p.user, amount: p.amount })),
+    pending: c.pending.map(p => ({ user: p.user, amount: p.amount })) })) });
