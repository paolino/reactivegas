+    case 'elect':
+      floatTx(`member:${a.target}`, '★', '#b98a1c'); flashKeys([`cassa:${a.target}`]); break;
+    case 'revoke': {
+      floatTx(`member:${a.target}`, '★✕', '#b3261e', 0, pre);
+      const [, ps] = stripCollections(a.target, preState.collections);
+      ps.forEach((p, i) => floatTx(`conto:${p.user}`, signedEur(p.amount), '#1c7c43', 150 + i * 130, pre));
+      break;
+    }
+    case 'departure': {
+      floatTx(`member:${a.target}`, '⇢ comune', '#1d5fbf', 0, pre);
+      flashKeys([`member:${a.target}`, `conto:${a.target}`]);
+      break;
+    }
+    case 'openPurchase': flashKeys([`pile:${a.c}`]); break;
+    case 'grantPermission': floatTx(`pile:${a.c}`, '⇣ L2 ✓ esito esterno', '#5b3e96'); break;
+    case 'denyPermission': {
+      const col = preCol(a.c);
+      [...col.accepted, ...col.pending].forEach((p, i) =>
+        fly(`pile:${a.c}`, `conto:${p.user}`, signedEur(p.amount), i * 140, pre));
+      break;
+    }
+    case 'deposit':
+      fly(`member:${a.user}`, `cassa:${a.author}`, eur(a.v));
+      floatTx(`conto:${a.user}`, signedEur(a.v), '#1c7c43', 250);
+      flashKeys([`conto:${a.user}`, `cassa:${a.author}`]);
+      break;
+    case 'withdraw':
+      fly(`cassa:${a.author}`, `member:${a.user}`, eur(a.v));
+      floatTx(`conto:${a.user}`, signedEur(-a.v), '#b3261e', 250);
