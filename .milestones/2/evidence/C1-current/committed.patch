+</style>
+</head>
+<body>
+<header>
+  <h1>Reactivegas <small class="mono">Types.lean · Step.lean — 14 eventi</small></h1>
+  <div class="hbtns">
+    <button type="button" id="inv-chip" class="ok" title="bilancio della macchina — dettaglio, prove e contro-fattuale">⚖ <b>0 ✓</b></button>
+    <button type="button" class="ghost" id="btn-log" title="log della sessione: esporta, importa, presenta — dati solo locali">Log</button>
+    <button type="button" class="ghost" id="btn-teach" title="rivedi le spiegazioni">?</button>
+    <button type="button" class="ghost danger" id="btn-reset" title="nuova sessione → State.empty">Reset</button>
