+  .gb[data-claim], .gbx[data-claim] { cursor: pointer; }
+  .prow { display: flex; gap: 7px; align-items: baseline; padding: 4px 2px; font-size: .82rem; }
+  .prow .pkind { flex: none; font-size: .64rem; font-weight: 700; border-radius: 5px; padding: 1px 6px; }
+  .prow .pkind.thm { background: #eef4fb; color: #23538f; border: 1px solid #b9cbe2; }
