+function raisePileZ(id) {
+  let z = 0;
+  for (const p of Object.values(pilePose))
+    if (p && Number.isFinite(p.z) && p.z > z) z = p.z;
+  const cur = pilePose[id] || {};
+  const ang = Number.isFinite(cur.angle)
+    ? cur.angle
+    : (layout['pile:' + id] && layout['pile:' + id].angle);
+  pilePose[id] = { angle: ang, z: z + 1 };
+}
+function raisePileNode(el) {
+  const svg = el && el.ownerSVGElement;
+  if (!svg) return;
+  const member = svg.querySelector('[data-obj="member"]');
+  if (member) svg.insertBefore(el, member);
+  else svg.appendChild(el);
+}
+function movePileOnRing(id, el, clientX, clientY) {
+  const svg = $('scene');
+  const pt = sceneClientToUser(svg, clientX, clientY);
+  if (!pt) return;
+  const CX = 380, CY = 350;
+  const slot = layout['pile:' + id] || {};
+  const r = Number.isFinite(slot.radius) ? slot.radius : 132;
+  const angle = Math.atan2(pt.y - CY, pt.x - CX);
+  const x = CX + r * Math.cos(angle), y = CY + r * Math.sin(angle);
+  layout['pile:' + id] = { x, y, angle, radius: r };
+  const z = (pilePose[id] && pilePose[id].z) || 0;
+  pilePose[id] = { angle, z };
+  if (el) el.setAttribute('transform', `translate(${x},${y})`);
+  const link = svg && svg.querySelector(`[data-reflink="${id}"]`);
+  const col = state.collections.find(c => c.id === id);
+  const rp = col && layout['member:' + col.referente];
+  if (link && rp) link.setAttribute('d', `M ${x} ${y} L ${rp.x} ${rp.y}`);
+}
