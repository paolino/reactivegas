+/* @@CORE:base-c@@ */
+function bgLawViolations(gs) {
+  const out = [];
+  for (const [pid, pp] of gs.pendingBase) {
+    if (new Set(pp.approvals).size !== pp.approvals.length)
+      out.push(`approvals_nodup: «${pid}»`);
