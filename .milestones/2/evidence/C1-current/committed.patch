+    }
+  }
+  for (const tag2 of Object.keys(TAG_CLAIMS))
+    if (!EVENT_ROUTES[tag2]) bad.push('riga di copertura per costruttore non instradato: ' + tag2);
+  for (const tag2 of Object.keys(EV))
