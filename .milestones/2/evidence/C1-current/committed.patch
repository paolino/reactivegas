+  if (env.version !== 1) fail('versione non supportata: ' + env.version);
+  if (!VT_THRESHOLDS[env.threshold]) fail('soglia sconosciuta: ' + env.threshold);
+  if (env.threshold !== VT_THRESHOLD_NAME)
