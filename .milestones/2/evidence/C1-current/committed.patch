+    const diffs = [...new Set([...Object.keys(ex.axioms), ...Object.keys(derived)])]
+      .filter(d => ex.axioms[d] !== derived[d])
+      .map(d => `${d}: embedded=${ex.axioms[d] || 'assente'} derivato=${derived[d] || 'assente'}`);
