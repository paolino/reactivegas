+const SVGNS = 'http://www.w3.org/2000/svg';
+
+function fxLayer() { const s = $('scene'); return s ? s.querySelector('#fx') : null; }
+
+function fly(fk, tk, txt, delay, pre) {
+  delay = delay || 0;
+  const f = layout[fk] || (pre && pre[fk]) || layout.world;
+  const t = layout[tk] || (pre && pre[tk]) || layout.world;
+  const gEl = document.createElementNS(SVGNS, 'g');
+  const c = document.createElementNS(SVGNS, 'circle');
+  c.setAttribute('class', 'coin'); c.setAttribute('r', '8');
+  const tx = document.createElementNS(SVGNS, 'text');
+  tx.setAttribute('class', 'cointx'); tx.setAttribute('y', '-13');
+  tx.textContent = txt;
+  gEl.appendChild(c); gEl.appendChild(tx);
+  const start = performance.now() + delay;
+  const dur = 700;
+  function frame(now) {
+    const layer = fxLayer();
+    if (!layer) return;
+    if (!gEl.parentNode && now >= start - 20) layer.appendChild(gEl);
+    const u = Math.min(1, Math.max(0, (now - start) / dur));
+    const e = u < .5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;
+    const x = f.x + (t.x - f.x) * e;
+    const y = f.y + (t.y - f.y) * e - 46 * Math.sin(Math.PI * u);
+    gEl.setAttribute('transform', `translate(${x},${y})`);
+    if (u < 1) requestAnimationFrame(frame);
+    else gEl.remove();
+  }
+  requestAnimationFrame(frame);
+}
+
+function floatTx(k, txt, color, delay, pre) {
+  const p = layout[k] || (pre && pre[k]);
+  if (!p) return;
+  const tx = document.createElementNS(SVGNS, 'text');
+  tx.setAttribute('class', 'floattx');
+  tx.setAttribute('fill', color || '#1c7c43');
+  tx.textContent = txt;
+  const start = performance.now() + (delay || 0);
+  const dur = 1000;
+  function frame(now) {
+    const layer = fxLayer();
+    if (!layer) return;
+    if (!tx.parentNode && now >= start - 20) layer.appendChild(tx);
+    const u = Math.min(1, Math.max(0, (now - start) / dur));
+    tx.setAttribute('x', p.x); tx.setAttribute('y', p.y - 20 - 26 * u);
+    tx.setAttribute('opacity', String(1 - u * u));
+    if (u < 1) requestAnimationFrame(frame);
+    else tx.remove();
+  }
+  requestAnimationFrame(frame);
+}
