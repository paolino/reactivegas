+
+/* Pure deterministic purchase-ring geometry. Members stay on the outer
+   circle in stable user order; open purchases sit on a concentric inner
+   ring, clustered angularly around their referente when that fits, else
+   packed evenly so glyphs do not overlap. Optional `poses` pins a
+   purchase to a user-chosen angle on the same ring. No DOM, storage,
+   time, or randomness. */
+/* Ruling expand (F-02): BOTH rings grow with the purchase count on a
+   pannable canvas — the 92-unit separation and the 42-unit glyph hold for
+   every reachable n with no cap and no paging. Member ANGLES keep the exact
+   legacy formula (stable for the same membership); only radii move, floored
+   so small-n output is byte-identical to legacy. Fixed rings with
+   pagination were rejected; shrinking glyphs are forbidden, so the render
+   radius is the constant 42 and user-dragged poses stay excluded by
+   statement (authored positions, not layout output). */
+function purchaseRingLayout(users, collections, poses) {
+  const CX = 380, CY = 350;
+  const MEMBER_RR = 38, PURCHASE_RR = 42, GAP = 8;
+  const MIN_DIST = 2 * PURCHASE_RR + GAP;
+  const RING_BASE = 132;
+  const n = Math.max(users.length, 1);
+  const ncols = collections.length;
+  // free variables: the pack ring grows so the angular slot chord always
+  // covers two glyphs plus the gap; the member ring stays outside the
+  // purchase glyphs (member edge clears purchase edge by 16).
+  const R_PACK = ncols < 2 ? RING_BASE
+    : Math.max(RING_BASE, MIN_DIST / (2 * Math.sin(Math.PI / ncols)));
+  const R_MEM = Math.max(220, R_PACK + PURCHASE_RR + MEMBER_RR + 16);
+  const CLUSTER_R = R_PACK, PACK_R = R_PACK;
+  const memberAngle = {};
+  const memberPos = {};
+  users.forEach((u, i) => {
+    const ang = -Math.PI / 2 + i * 2 * Math.PI / n;
+    memberAngle[u] = ang;
+    memberPos[u] = { x: CX + R_MEM * Math.cos(ang), y: CY + R_MEM * Math.sin(ang) };
+  });
+  // canvas extent floored at the legacy 760x680 so small-n output keeps it
+  const halfW = Math.max(380, R_MEM + MEMBER_RR + 24);
+  const halfH = Math.max(340, R_MEM + MEMBER_RR + 24);
+  const extent = { cx: CX, cy: CY, halfW, halfH, w: 2 * halfW, h: 2 * halfH };
+  const rings = { member: R_MEM, pack: R_PACK };
+  if (!collections.length) return { memberPos, placements: [], extent, rings };
+
+  const groups = [];
+  for (const u of users) {
+    const cols = collections.filter(c => c.referente === u);
+    if (cols.length) groups.push({ ref: u, cols });
+  }
+  for (const c of collections) {
+    if (groups.some(g => g.cols.includes(c))) continue;
+    let g = groups.find(x => x.ref === c.referente);
+    if (!g) { g = { ref: c.referente, cols: [] }; groups.push(g); }
+    g.cols.push(c);
+  }
+
+  const clusterEligible = groups.every(g => g.cols.length <= 5);
+  const chordStep = 2 * Math.asin(Math.min(1, MIN_DIST / (2 * CLUSTER_R)));
+
+  const at = (ringR, angle, c, ref) => ({
+    purchaseId: c.id, referente: ref,
+    x: CX + ringR * Math.cos(angle), y: CY + ringR * Math.sin(angle),
+    angle, radius: ringR,
+  });
+
+  if (clusterEligible) {
+    const clustered = [];
+    for (const g of groups) {
+      const base = memberAngle[g.ref] != null ? memberAngle[g.ref] : -Math.PI / 2;
+      const m = g.cols.length;
+      const step = m <= 1 ? 0 : chordStep;
+      const start = base - step * (m - 1) / 2;
+      g.cols.forEach((c, j) => clustered.push(at(CLUSTER_R, start + j * step, c, g.ref)));
+    }
+    const separated = clustered.every((p, i) => clustered.slice(i + 1).every(q =>
+      Math.hypot(p.x - q.x, p.y - q.y) >= MIN_DIST - 0.5));
+    if (separated)
+      return { memberPos, placements: applyPilePoses(clustered, poses, at), extent, rings };
+  }
+
+  const ordered = groups.flatMap(g => g.cols);
+  const k = ordered.length;
+  const slot = 2 * Math.PI / k;
+  const angDiff = (a, b) => {
+    let d = Math.abs(a - b) % (2 * Math.PI);
+    if (d > Math.PI) d = 2 * Math.PI - d;
+    return d;
+  };
+  let bestR = 0, bestCost = Infinity, idx = 0;
+  for (const g of groups) {
+    const mid = idx + (g.cols.length - 1) / 2;
+    const target = memberAngle[g.ref] != null ? memberAngle[g.ref] : -Math.PI / 2;
+    const r = target - mid * slot;
+    let cost = 0, j = 0;
+    for (const gg of groups) {
+      const gm = j + (gg.cols.length - 1) / 2;
+      const want = memberAngle[gg.ref] != null ? memberAngle[gg.ref] : -Math.PI / 2;
+      cost += angDiff(r + gm * slot, want) * gg.cols.length;
+      j += gg.cols.length;
+    }
+    if (cost < bestCost) { bestCost = cost; bestR = r; }
+    idx += g.cols.length;
+  }
+  // pack fallback on the grown ring: the slot chord covers two 42-glyphs
+  // plus the gap by the R_PACK construction above (strict except fp dust).
+  const placements = ordered.map((c, j) => at(PACK_R, bestR + j * slot, c, c.referente));
+  return { memberPos, placements: applyPilePoses(placements, poses, at), extent, rings };
+}
+
+function applyPilePoses(placements, poses, at) {
+  if (!poses) return placements;
+  return placements.map(p => {
+    const pose = poses[p.purchaseId];
+    if (!pose || !Number.isFinite(pose.angle)) return p;
+    const col = { id: p.purchaseId };
+    const q = at(p.radius, pose.angle, col, p.referente);
+    q.z = Number.isFinite(pose.z) ? pose.z : 0;
+    return q;
+  });
+}
