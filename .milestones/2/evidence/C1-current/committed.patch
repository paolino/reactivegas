+function amountSpec(tag, p) {
+  switch (tag) {
+    case 'deposit':
+      return { min: 0, max: TOYMAX, val: 50, what: `accredito: ${nm(p.user)} versa a ${nm(p.author)}` };
+    case 'withdraw': {
+      const b = Math.max(0, bal(state.conti, p.user));
+      return { min: 0, max: b, val: Math.min(b, 20), what: `prelievo di ${nm(p.user)} (conto ${eur(b)})` };
+    }
+    case 'transferCassa':
+      return { min: 1, max: TOYMAX, val: 50, what: `cassa ${nm(p.from_)} → cassa ${nm(p.author)}` };
+    case 'pledge': {
+      const b = bal(state.conti, p.user);
+      return { min: 1, max: b, val: Math.min(b, 20), what: `impegno di ${nm(p.user)} su «${lbl(p.c)}» (conto ${eur(b)})` };
