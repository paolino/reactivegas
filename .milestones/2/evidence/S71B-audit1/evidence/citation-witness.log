theorem close_spends_referente : ∀ {view : KelGroups.GroupView} {auth : BackdonateAuth} {s s' : State}
  {a : KelGroups.Key} {c : CollId},
  stepEvent view s (Event.closePurchase a c) auth = some s' →
    ∃ col rest,
      pullCollection c s.collections = some (col, rest) ∧
        bal s'.casse col.referente = bal s.casse col.referente - sumPledges col.accepted :=
fun {view} {auth} {s s'} {a} {c} h =>
  Exists.casesOn (step_close_inv h) fun col h_1 =>
    Exists.casesOn h_1 fun rest h_2 =>
      And.casesOn h_2 fun hpull right =>
        And.casesOn right fun left hs' =>
          Eq.ndrec (motive := fun {s'} =>
            stepEvent view s (Event.closePurchase a c) auth = some s' →
              ∃ col rest,
                pullCollection c s.collections = some (col, rest) ∧
                  bal s'.casse col.referente = bal s.casse col.referente - sumPledges col.accepted)
            (fun h =>
              Exists.intro col
                (Exists.intro rest
                  ⟨hpull,
                    id
                      (have hb := bal_bump s.casse col.referente (-sumPledges col.accepted);
                      Decidable.byContradiction fun a => close_spends_referente._proof_1_1 col hb a)⟩))
            (Eq.symm hs') h
'close_spends_referente' depends on axioms: [propext, Quot.sound]
def authorizedStep : KelGroups.GroupView → State → Event → State → Prop :=
fun view _s e _s' =>
  match e with
  | Event.openPurchase a c => isResponsabile view a = true
  | Event.grantPermission a c => isResponsabile view a = true
  | Event.denyPermission a c => isResponsabile view a = true
  | Event.donate a v => isResponsabile view a = true
  | Event.backdonate a w => isResponsabile view a = true
  | Event.deposit a user v => isResponsabile view a = true
  | Event.withdraw a user v => isResponsabile view a = true
  | Event.transferCassa a from_ v => isResponsabile view a = true
  | Event.pledge a user c v => isResponsabile view a = true
  | Event.acceptPledge a user c => isResponsabile view a = true
  | Event.refusePledge a user c => isResponsabile view a = true
  | Event.correctPledge a user c v => isResponsabile view a = true
  | Event.closePurchase a c => isResponsabile view a = true
  | Event.failPurchase a c => isResponsabile view a = true
