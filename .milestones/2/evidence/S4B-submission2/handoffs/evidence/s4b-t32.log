comune_not_a_member_corr : ∀ (view : KelGroups.GroupView),
  comune_not_a_member view ↔ (!KelGroups.GroupView.isMember comuneId view) = true
conservation_corr : ∀ (s : State), conservation s ↔ conservationB s = true
solvent_corr : ∀ (view : KelGroups.GroupView) (s : State), solvent view s ↔ solventB view s = true
insolvent_corr : ∀ (view : KelGroups.GroupView) (s : State), insolvent view s ↔ insolventB view s = true
uniquePledges_corr : ∀ (col : Collection), uniquePledges col ↔ uniquePledgesB col = true
allUniquePledges_corr : ∀ (s : State), allUniquePledges s ↔ allUniquePledgesB s = true
permissionToClose_corr : ∀ (col : Collection), permissionToClose col ↔ (col.permitted && col.pending.isEmpty) = true
escrowHeld_corr : ∀ (col : Collection) (u : KelGroups.Key) (v : Int), escrowHeld col u v ↔ escrowHeldB col u v = true
governanceEnacts_corr : ∀ (u : KelGroups.Key) (s' : State), governanceEnacts u s' ↔ governanceEnactsB u s' = true
doubleEntry_corr : ∀ (s s' : State) (a u : KelGroups.Key) (v : Int),
  doubleEntry s s' a u v ↔ doubleEntryB s s' a u v = true
canCloseGroup_corr : ∀ (view : KelGroups.GroupView) (s : State), canCloseGroup view s ↔ canCloseGroupB view s = true
KelGroups.pendingWellFormed_corr : ∀ (pending : KelGroups.PendingProposal),
  KelGroups.PendingWellFormed pending ↔ KelGroups.pendingWellFormedB pending = true
@KelGroups.membersCoherent_corr : ∀ {α : Type} (gs : KelGroups.GroupState α),
  KelGroups.MembersCoherent gs ↔ KelGroups.membersCoherentB gs = true
@KelGroups.pendingCoherent_corr : ∀ {α : Type} (gs : KelGroups.GroupState α),
  KelGroups.PendingCoherent gs ↔ KelGroups.pendingCoherentB gs = true
@KelGroups.wellFormed_corr : ∀ {α : Type} (gs : KelGroups.GroupState α),
  KelGroups.WellFormed gs ↔ KelGroups.wellFormedB gs = true
@KelGroups.enacts_corr : ∀ {α : Type} [inst : DecidableEq α] (gs : KelGroups.GroupState α)
  (proposalId : KelGroups.ProposalId) (result : KelGroups.GroupState α),
  KelGroups.Enacts gs proposalId result ↔ KelGroups.enactsB gs proposalId result = true
KelGroups.Vote.questionClean_corr : ∀ (q : KelGroups.Vote.Question),
  KelGroups.Vote.QuestionClean q ↔ KelGroups.Vote.questionCleanB q = true
KelGroups.Vote.sweepReady_corr : ∀ (view : KelGroups.GroupView) (gs : KelGroups.Vote.VoteState),
  KelGroups.Vote.SweepReady view gs ↔ KelGroups.Vote.sweepReadyB view gs = true
KelGroups.Vote.voteWellFormed_corr : ∀ (θ : KelGroups.Vote.Threshold) (view : KelGroups.GroupView)
  (gs : KelGroups.Vote.VoteState),
  KelGroups.Vote.VoteWellFormed θ view gs ↔ KelGroups.Vote.voteWellFormedB θ view gs = true
