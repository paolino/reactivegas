+# Owned-module inventory for provenance-based ownership and import-reach
+# completeness (NOTE-015): mirrors the S2R tracked rule exactly (git-tracked
+# `.lean` under `lean/`, minus `lakefile.lean`, path mapped to module name).
+# S2R's tracked/walked gate already rejects untracked-but-present sources
+# upstream, so `ls-files` is the complete owned set here by layering.
+TRACKED_LEAN=$(git -C "$HERE/.." ls-files -- 'lean' | grep -E '\.lean$' | sort | while IFS= read -r f; do
+  rel=${f#lean/}; [ "$rel" = lakefile.lean ] && continue
+  printf '%s\n' "${rel%.lean}" | tr '/' '.'
+done)
+TRACKED_LIT=$(printf '%s\n' "$TRACKED_LEAN" | sed 's/.*/"&"/' | paste -sd' ' -)
