+def s4bTrackedModules : Array String := #__TRACKED_MODULES__
   let env ← getEnv
   let mods := env.header.moduleNames
   let nonce ← IO.getEnv "S4B_MIRROR_NONCE"
@@ -201,7 +217,7 @@ run_cmd do
           | some m => toString m
