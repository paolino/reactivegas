+# Bake the per-run tracked inventory into the driver (pure bash: the heredoc
+# stays quoted so Lean backticks never expand). Then build the exe target the
+# driver imports (incremental; same substantive run, log-visible, never hidden
+# work — default `lake build` skips non-default exe targets, verified against
+# the lakefile and the S2R worktree's missing exe oleans).
+driver_text=$(cat "$DRIVER")
+driver_text=${driver_text//#__TRACKED_MODULES__/$TRACKED_LIT}
+printf '%s' "$driver_text" > "$DRIVER"
