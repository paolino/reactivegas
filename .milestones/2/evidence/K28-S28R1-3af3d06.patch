+                `shouldBe` Map.keysSet (members gs)
+            lookupMemberInView "absent-witness-9" (groupView post)
+                `shouldBe` Nothing
         it "nonempty pendingBase roundtrips through JSON" $ do
             let pending =
                     PendingBase
