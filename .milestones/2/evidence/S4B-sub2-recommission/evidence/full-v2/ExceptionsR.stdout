inductive Reach : KelGroups.GroupView → BackdonateAuth → State → Prop
number of parameters: 2
constructors:
Reach.boot : ∀ {view : KelGroups.GroupView} {auth : BackdonateAuth},
  comune_not_a_member view → Reach view auth State.empty
Reach.trans : ∀ {view : KelGroups.GroupView} {auth : BackdonateAuth} {s : State} {e : Event} {s' : State},
  Reach view auth s → stepEvent view s e auth = some s' → Reach view auth s'
inductive Reach.below : {view : KelGroups.GroupView} →
  {auth : BackdonateAuth} → {motive : (a : State) → Reach view auth a → Prop} → {a : State} → Reach view auth a → Prop
number of parameters: 3
constructors:
Reach.below.boot : ∀ {view : KelGroups.GroupView} {auth : BackdonateAuth}
  {motive : (a : State) → Reach view auth a → Prop} (h : comune_not_a_member view), Reach.below ⋯
Reach.below.trans : ∀ {view : KelGroups.GroupView} {auth : BackdonateAuth}
  {motive : (a : State) → Reach view auth a → Prop} {s : State} {e : Event} {s' : State} (a : Reach view auth s)
  (a_1 : stepEvent view s e auth = some s'), Reach.below a → motive s a → Reach.below ⋯
