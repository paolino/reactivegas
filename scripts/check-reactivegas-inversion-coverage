#!/usr/bin/env bash
set -euo pipefail
#
# Reconcile the Reactivegas.Event surface with the successful-step inversion
# theorems that invert it.
#
# Every signal is read from the *elaborated* Lean environment or from a real
# Lean *parse* of the sources: the Event constructors come from the inductive
# declaration, coverage comes from active theorem declarations and their own
# successful-`stepEvent` hypotheses, and the regression count is the set of
# theorem commands the Lean parser finds, each required to be backed by an
# elaborated theorem at that source position. Comments, string literals,
# indentation, nesting and non-theorem commands are resolved by the parser and
# the environment, never by a textual convention of this file.
#
# Each inversion is bound to the one constructor its own public name claims,
# and to exactly one successful-`stepEvent` hypothesis observing it: a repeated
# hypothesis or a name/constructor permutation is a finding. The association is
# nominal only; guards and successors are never written here.
#
# Every inversion the audit binds to a constructor is additionally held to its
# live branch: the audit builds the converse of the theorem's *own* conclusion
# and requires it to be provable. A conclusion weaker than the branch guard, or
# naming a successor other than the branch's, makes that converse false and the
# audit fails naming the theorem. The held set is the discovered binding, one
# inversion per constructor; no name list selects it. The expected guard is
# never written down here, so this file holds no copy of the transition policy.
#
# --negative-control withholds one constructor that really contributes coverage
# and requires the identical comparison to reject the gap it opens. It then
# weakens every bound inversion's conclusion by one guard conjunct and requires
# the identical converse check to reject each weakened conclusion. A rejection
# counts only when the weakened statement type-checks, is the original with a
# conjunct omitted and nothing else, and its converse stops on an unsolved goal;
# anything else is a malformed control and fails the run. Last, it weakens every
# bound inversion into a statement that does not type-check and requires each one
# to be reported as malformed, never as a rejection.

TOOL=check-reactivegas-inversion-coverage

usage() {
    printf 'usage: %s [--negative-control] [REPO_ROOT]\n' "$TOOL" >&2
    exit 64
}

negative=0
while [ $# -gt 0 ]; do
    case $1 in
        --negative-control) negative=1 ;;
        -h|--help) usage ;;
        --) shift; break ;;
        -*) usage ;;
        *) break ;;
    esac
    shift
done
[ $# -le 1 ] || usage

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "${1:-$script_dir/..}" && pwd)
lean_dir="$root/lean"

[ -d "$lean_dir" ] || {
    printf '%s: missing Lean sources: %s\n' "$TOOL" "$lean_dir" >&2
    exit 1
}

tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT

# S — tracked source modules: git-tracked `.lean` under `lean/` except the Lake
# package configuration. Walked sources on disk are derived independently and
# must agree as sets; a tracked-but-missing or untracked-but-present source is
# a finding. Nothing about a module's *text* selects it.
mapfile -t tracked < <(
    git -C "$root" ls-files -- 'lean' \
        | grep -E '\.lean$' \
        | sort \
        | while IFS= read -r f; do
            rel=${f#lean/}
            [ "$rel" = lakefile.lean ] && continue
            printf '%s\n' "${rel%.lean}" | tr '/' '.'
        done
)
mapfile -t walked < <(
    find "$lean_dir" -name '.lake' -prune -o -name '*.lean' -type f -print \
        | sort \
        | while IFS= read -r file; do
            rel=${file#"$lean_dir"/}
            [ "$rel" = lakefile.lean ] && continue
            printf '%s\n' "${rel%.lean}" | tr '/' '.'
        done
)
if [ "${#tracked[@]}" -eq 0 ]; then
    printf '%s: derived zero tracked source modules from %s\n' \
        "$TOOL" "$lean_dir" >&2
    exit 1
fi
if [ "${#walked[@]}" -eq 0 ]; then
    printf '%s: derived zero walked source modules from %s\n' \
        "$TOOL" "$lean_dir" >&2
    exit 1
fi
if ! diff <(printf '%s\n' "${tracked[@]}") <(printf '%s\n' "${walked[@]}") >"$tmp/swalk.diff" 2>&1; then
    printf '%s: tracked/walked source discovery disagrees\n' "$TOOL" >&2
    cat "$tmp/swalk.diff" >&2
    exit 1
fi
modules=("${tracked[@]}")
printf '%s: sources tracked=%s walked=%s\n' "$TOOL" "${#tracked[@]}" "${#walked[@]}" >&2

# The environment must be the current source, not whatever was compiled last.
(cd "$lean_dir" && lake build "${modules[@]}" >"$tmp/build.log" 2>&1) || {
    printf '%s: lake build failed\n' "$TOOL" >&2
    cat "$tmp/build.log" >&2
    exit 1
}

{
    printf 'import Lean\n'
    printf 'import %s\n' "${modules[@]}"
    cat <<'LEANEOF'

open Lean Meta Elab Term

namespace InversionAudit

def permittedAxioms : List Name := [`propext, `Classical.choice, `Quot.sound]

/-- Ownership authority (canonicalized resolved-olean provenance). The loader's own
search path (`searchPathRef`: `LEAN_PATH` order plus the toolchain builtin)
resolves each environment module to the olean artifact it actually loaded
(`findModuleWithExt`, existence-checked, first-package-root rule). Both the
repo root and each resolved artifact are canonicalized with `IO.FS.realPath`
(relative entries, `.`/`..`, symlinked vendor dirs) before a
trailing-separator prefix comparison. No name list, no import closure. -/
def canonRoot (root : String) : TermElabM (Except String String) := do
  try
    let p ← IO.FS.realPath root
    let mut s := p.toString
    if !s.endsWith "/" then s := s ++ "/"
    return .ok s
  catch _ => return .error s!"cannot canonicalize project root {root}"

def artifactInsideRoot (rootCanon : String) (art : System.FilePath) :
    TermElabM Bool := do
  try
    let r ← IO.FS.realPath art
    return rootCanon.isPrefixOf r.toString
  catch _ => return false

def resolveProjectModules (env : Environment) (rootCanon : String) :
    TermElabM (Except String (Array Name)) := do
  let sp ← Lean.searchPathRef.get
  let mut acc := #[]
  let mut noArtifact : Array String := #[]
  for m in env.header.moduleNames do
    let found ← sp.findModuleWithExt "olean" m
    match found with
    | none => noArtifact := noArtifact.push m.toString
    | some p =>
      if ← artifactInsideRoot rootCanon p then acc := acc.push m
  if !noArtifact.isEmpty then
    return .error
      s!"modules with no loadable olean artifact: {", ".intercalate noArtifact.toList}"
  return .ok acc
/-- The Lake package description is not a library module: nothing declared in
it can reach the project environment, and it is elaborated by Lake, not here. -/
def lakeConfig : String := "lakefile.lean"

/-- Every constant this project itself declares, with its module. The project set
comes from resolved-olean provenance, never from a name list or import closure. -/
def projectConstants (env : Environment) (proj : Array Name) :
    Array (Name × Name × ConstantInfo) := Id.run do
  let mut acc := #[]
  for i in [0 : env.header.moduleNames.size] do
    let some m := env.header.moduleNames[i]? | continue
    if !proj.contains m then continue
    let some data := env.header.moduleData[i]? | continue
    for n in data.constNames do
      if n.isInternalDetail then continue
      if let some ci := env.find? n then acc := acc.push (m, n, ci)
  return acc

/-- `lean/A/B.lean` for module `A.B`, total: non-string components yield an
unmatchable sentinel rather than panicking. Callers compare canonical realpaths,
so a sentinel is a finding, never a crash. -/
def modulePath (root : String) (m : Name) : String :=
  let parts := m.components.filterMap (fun c => match c with | .str _ s => some s | _ => none)
  if parts.length != m.components.length then root ++ "/lean/__nonstring__.lean"
  else root ++ "/lean/" ++ "/".intercalate parts ++ ".lean"

partial def leanSources (dir : System.FilePath) : IO (Array System.FilePath) := do
  let mut acc := #[]
  for e in (← dir.readDir) do
    if e.fileName == ".lake" then continue
    if e.fileName == lakeConfig then continue
    if (← e.path.isDir) then acc := acc ++ (← leanSources e.path)
    else if e.fileName.endsWith ".lean" then acc := acc.push e.path
  return acc

/-- Does this declaration carry the `private` visibility modifier? A private
theorem is not part of the project's theorem surface: it is elaborated under an
internal name and never enters the constant sweep, so it must not enter the
declaration count either. -/
partial def isPrivateDecl (stx : Syntax) : Bool :=
  match stx with
  | .node _ k args => k == ``Lean.Parser.Command.«private» || args.any isPrivateDecl
  | _ => false

/-- Every active `theorem` command inside one parsed command, wherever it sits
in the syntax tree, as `(line, identifier)`. The parser decides what is a
declaration: text in a comment or a string literal never produces one, leading
whitespace is irrelevant, and `def`/`example`/`axiom`/`abbrev` carry other
kinds. -/
partial def theoremDeclsOf (fm : FileMap) (stx : Syntax) : Array (Nat × String) :=
  let here : Array (Nat × String) :=
    if stx.isOfKind ``Lean.Parser.Command.declaration then
      let body := stx[1]
      if body.isOfKind ``Lean.Parser.Command.«theorem» && !isPrivateDecl stx[0] then
        let ident := body[1][0]
        match ident.getPos? with
        | some pos => #[((fm.toPosition pos).line, ident.getId.toString)]
        | none => #[]
      else #[]
    else #[]
  match stx with
  | .node _ _ args => args.foldl (fun acc s => acc ++ theoremDeclsOf fm s) here
  | _ => here

/-- Parse one source file with the real Lean parser, in this audit's own
environment, and return every theorem command it contains. A file the parser
cannot read is a finding, not an empty file: unparsed text could hide a
declaration. -/
def parsedTheoremDecls (env : Environment) (path : System.FilePath) :
    IO (Except String (Array (Nat × String))) := do
  let txt ← IO.FS.readFile path
  let inputCtx := Parser.mkInputContext txt path.toString
  let (_, headerState, headerMsgs) ← Parser.parseHeader inputCtx
  let pmctx : Parser.ParserModuleContext := { env := env, options := {} }
  let mut state := headerState
  let mut msgs := headerMsgs
  let mut acc : Array (Nat × String) := #[]
  repeat
    let (stx, state', msgs') := Parser.parseCommand inputCtx pmctx state msgs
    state := state'
    msgs := msgs'
    acc := acc ++ theoremDeclsOf inputCtx.fileMap stx
    if Parser.isTerminalCommand stx then break
  if msgs.hasErrors then
    return .error s!"{path}: Lean could not parse this file; a declaration could be hidden"
  return .ok acc

/-- Elaborated theorems of this project, at the source position they occupy. -/
def elaboratedTheorems (env : Environment) (proj : Array Name) :
    CoreM (Array (Name × Nat × Name)) := do
  let mut acc := #[]
  for (m, n, ci) in projectConstants env proj do
    if let .thmInfo _ := ci then
      if let some r ← findDeclarationRanges? n then
        acc := acc.push (m, r.selectionRange.pos.line, n)
  return acc

def eventCtors (env : Environment) : Except String (List Name) :=
  match env.find? `Event with
  | some (.inductInfo i) => .ok i.ctors
  | some _ => .error "`Event` is not an inductive type"
  | none => .error "`Event` is absent from the elaborated environment"

def isInversionName (n : Name) : Bool :=
  let s := n.getString!
  "step_".isPrefixOf s && s.endsWith "_inv"

/-- The `Event` constructor an inversion theorem claims by its own public name:
`step_<stem>_inv` claims the constructor the stem names, and the audit refuses
an ambiguous or absent claim. This associates *identifiers* only — the elaborated
constructor list is the authority on which constructors exist, and no guard or
successor is restated here. -/
def claimedCtor (ctors : List Name) (n : Name) : Except String Name :=
  let stem := ((n.getString!).drop "step_".length).dropRight "_inv".length
  if stem.isEmpty then
    .error s!"{n}: names no `Event` constructor stem"
  else
    match ctors.filter (fun c => c.getString! == stem) with
    | [c] => .ok c
    | _ =>
      match ctors.filter (fun c => stem.isPrefixOf c.getString!) with
      | [c] => .ok c
      | [] => .error s!"{n}: no `Event` constructor is named by the stem `{stem}`"
      | cs =>
        .error s!"{n}: the stem `{stem}` names {cs.length} `Event` constructors: {" ".intercalate (cs.map (·.getString!))}"

/-- The event constructor of a successful-`stepEvent` proposition, if this is
one. -/
def successOf (t : Expr) : MetaM (Option Name) := do
  let some (_, lhs, rhs) := t.eq? | return none
  unless lhs.isAppOf ``stepEvent && rhs.isAppOf ``Option.some do return none
  let args := lhs.getAppArgs
  if args.size < 3 then return none
  let .const c _ := args[2]!.getAppFn | return none
  return some c

/-- Every successful-`stepEvent` hypothesis of this theorem, in order and
without collapsing repeats: two hypotheses observing the same step are two
observations, and an inversion that carries a spare one is not the theorem the
audit requires. -/
def coveredBy (ti : TheoremVal) : MetaM (Array Name) :=
  forallTelescope ti.type fun xs _ => do
    let mut acc : Array Name := #[]
    for x in xs do
      if let some c ← successOf (← inferType x) then
        acc := acc.push c
    return acc

/-- The last guard conjunct of an inversion conclusion, weakened: the conclusion
has the shape `∃ …, binding ∧ … ∧ guard ∧ successor`, the successor being its
last conjunct. A guard stated as a Boolean conjunction `(x && y) = true` loses
its last operand `y`; any other guard conjunct is removed whole. The result is a
conclusion that omits one live guard conjunct, built from the theorem's own
conclusion. `none` when the conclusion has no guard conjunct to weaken. -/
partial def weakenLastGuard (e : Expr) : Option Expr :=
  let isTrue (x : Expr) := x.isConstOf ``Bool.true
  if e.isAppOfArity ``Exists 2 then
    match e.getAppArgs[1]! with
    | .lam n t b bi =>
      -- the original `Exists` keeps its own universe level
      (weakenLastGuard b).map fun b' =>
        mkApp2 e.getAppFn e.getAppArgs[0]! (.lam n t b' bi)
    | _ => none
  else if e.isAppOfArity ``And 2 then
    let a := e.getAppArgs[0]!
    let b := e.getAppArgs[1]!
    if b.isAppOfArity ``And 2 || b.isAppOfArity ``Exists 2 then
      (weakenLastGuard b).map fun b' => mkApp2 (mkConst ``And) a b'
    else if a.isAppOfArity ``Eq 3 && isTrue a.getAppArgs[2]!
        && a.getAppArgs[1]!.isAppOfArity ``and 2 then
      let x := a.getAppArgs[1]!.getAppArgs[0]!
      some (mkApp2 (mkConst ``And)
        (mkApp3 a.getAppFn a.getAppArgs[0]! x (mkConst ``Bool.true)) b)
    else some b
  else none

/-- The conjuncts of a conclusion `∃ …, a ∧ b ∧ …`, in order, existential binders
skipped. Bound variables stay loose, so two conclusions with the same binders
compare structurally. -/
partial def atoms (e : Expr) : List Expr :=
  if e.isAppOfArity ``Exists 2 then
    match e.getAppArgs[1]! with
    | .lam _ _ b _ => atoms b
    | _ => [e]
  else if e.isAppOfArity ``And 2 then atoms e.getAppArgs[0]! ++ atoms e.getAppArgs[1]!
  else [e]

def isSubsequence : List Expr → List Expr → Bool
  | [], _ => true
  | _ :: _, [] => false
  | a :: as, b :: bs => if a.eqv b then isSubsequence as bs else isSubsequence (a :: as) bs

/-- `weakened` is `original` with conjuncts removed, or with the last operand of
one Boolean conjunction guard removed, and nothing else changed. -/
def omitsOnlyAConjunct (original weakened : Expr) : Bool :=
  let c := atoms original
  let w := atoms weakened
  (w.length < c.length && isSubsequence w c) ||
    (w.length == c.length &&
      let diff := (c.zip w).filter fun p => !p.1.eqv p.2
      diff.length == 1 && diff.all fun p =>
        p.1.isAppOfArity ``Eq 3 && p.2.isAppOfArity ``Eq 3
          && p.1.getAppArgs[1]!.isAppOfArity ``and 2
          && p.1.getAppArgs[1]!.getAppArgs[0]!.eqv p.2.getAppArgs[1]!)

/-- A deliberately malformed weakening, for the control of the control: the
statement is conjoined with a non-proposition, so it does not type-check. -/
def illTyped (e : Expr) : Expr :=
  mkApp2 (mkConst ``And) e (mkConst ``Nat)

/-- `proved`: the converse holds. `insufficient`: it fails, the statement is
well-typed, and the proof stops on an unsolved goal — the conclusion does not
entail the step. `malformed`: anything else (an ill-typed statement, a failure
that is not an unsolved goal, `sorry`, metavariables). -/
inductive Tight where
  | proved
  | insufficient (msg : String)
  | malformed (msg : String)

/-- A failed converse proof is the conclusion's insufficiency only when the tactic
block stops on a goal it could not close. Any other failure — an elaboration
error, a type mismatch, an unknown constant, a tactic that finds nothing to rewrite
in an ill-typed goal — says nothing about the conclusion. -/
def stopsOnOpenGoal (msg : String) : Bool :=
  "unsolved goals".isPrefixOf msg

inductive Run where
  | proved
  | failed (msg : String)
  | broken (msg : String)

/-- Run `by <tactic>` against `goal`. A failing tactic block logs its error
instead of throwing it; the log is taken over here so a failure is attributed to
the theorem under audit and does not surface as an anonymous message. -/
def runProof (stx : Syntax) (goal : Expr) : TermElabM Run := do
  let saved ← Core.getMessageLog
  Core.resetMessageLog
  let outcome ← try
      let pf ← withLCtx {} #[] <| withoutErrToSorry (elabTermEnsuringType stx goal)
      synthesizeSyntheticMVarsNoPostponing
      let pf ← instantiateMVars pf
      if pf.hasSorry then pure (Run.broken "converse proof used sorry")
      else if pf.hasExprMVar then pure (Run.broken "converse proof left metavariables")
      else
        check pf
        pure Run.proved
    catch e =>
      pure (Run.failed (← e.toMessageData.toString))
  let logged ← Core.getMessageLog
  (modify fun (st : Core.State) => { st with messages := saved } : CoreM Unit)
  for m in logged.toList do
    if m.severity == .error then
      return .failed (← m.data.toString)
  return outcome

/-- Build the converse of an inversion theorem from the theorem itself and
require it to hold: its own conclusion must be sufficient for the successful
step it inverts. The hypothesis direction already makes the conclusion
necessary, so together they pin the branch's complete guard and exact
successor. Nothing here restates either. With `weaken`, the same check is run
on the conclusion with one guard conjunct omitted, and it is judged as a
control: the weakened statement must type-check and be a consequence of the
original conclusion, and the converse must then fail on an unsolved goal; any
other outcome is `malformed`, never a rejection. `corrupt` makes the weakened
statement ill-typed on purpose, to show the control refuses it. -/
def tightnessProved (n : Name) (ti : TheoremVal) (weaken : Bool := false)
    (corrupt : Bool := false) : TermElabM Tight := do
  let stx ← `(term| by
    simp only [exists_imp, and_imp]
    intros
    subst_vars
    simp_all [stepEvent, step, demand])
  let flat (m : String) := (m.replace "\n" " ").take 220
  forallTelescope ti.type fun xs body => do
    if xs.isEmpty then return .malformed s!"{n}: has no binders"
    let hty ← inferType xs.back!
    if (← successOf hty).isNone then
      return .malformed s!"{n}: its last hypothesis is not a successful `stepEvent`"
    let original ← instantiateMVars body
    let some concl := if weaken then weakenLastGuard original else some original
      | return .malformed s!"{n}: its conclusion has no guard conjunct to weaken"
    let concl := if corrupt then illTyped concl else concl
    let goal ← mkForallFVars xs.pop (← mkArrow concl hty)
    -- A statement that does not type-check is not a conclusion that fails to
    -- entail the step: it is a malformed control.
    try
      check goal
      unless (← isProp goal) do throwError "it is not a proposition"
    catch e =>
      return .malformed
        s!"{n}: the {if weaken then "weakened" else "unweakened"} statement is ill-typed: {flat (← e.toMessageData.toString)}"
    -- what separates the weakened statement from the original must be the
    -- omitted conjunct and nothing else
    if weaken && !omitsOnlyAConjunct original concl then
      return .malformed s!"{n}: the weakened statement differs from the original by more than an omitted conjunct"
    match ← runProof stx goal with
    | .proved => return .proved
    | .broken e => return .malformed s!"{n}: {e}"
    | .failed e =>
      if stopsOnOpenGoal e then
        return .insufficient s!"{n}: its conclusion does not entail the live branch: {flat e}"
      else
        return .malformed s!"{n}: the converse failed, but not on an unsolved goal: {flat e}"

/-- The one comparison. The negative control runs it against a deliberately
withheld coverage set, so the passing and failing paths are the same code. -/
def compareCoverage (ctors : List Name) (covered : List (Name × Name)) :
    Except String String := do
  let coveredCtors := covered.map (·.2)
  let missing := ctors.filter (fun c => !coveredCtors.contains c)
  let phantom := coveredCtors.filter (fun c => !ctors.contains c)
  let dups := coveredCtors.filter (fun c => (coveredCtors.filter (· == c)).length > 1)
  let line := s!"inversion-coverage constructors={ctors.length} covered={coveredCtors.eraseDups.length} missing={missing.length} phantom={phantom.length}"
  unless missing.isEmpty do
    throw s!"{line}\nmissing: {" ".intercalate (missing.map (·.getString!))}"
  unless phantom.isEmpty do
    throw s!"{line}\nphantom: {" ".intercalate (phantom.map (·.getString!))}"
  unless dups.isEmpty do
    throw s!"{line}\nduplicate: {" ".intercalate (dups.eraseDups.map (·.getString!))}"
  return line

abbrev Report := StateT (Array String) TermElabM

def fail (m : String) : Report Unit := modify (·.push m)

def audit (root : String) (negative : Bool) : Report Unit := do
  let env ← getEnv
  let rootCanon ← match ← canonRoot root with
    | .ok r => pure r
    | .error e => fail e; pure (root ++ "/")
  let proj ← match ← resolveProjectModules env rootCanon with
    | .ok p => pure p
    | .error e => fail e; pure #[]
  let constants := projectConstants env proj
  IO.println s!"inversion-sources root={rootCanon} modules={proj.size}"
  if proj.isEmpty then fail "derived zero built project modules"

  let ctors ←
    match eventCtors env with
    | .error e => fail e; pure []
    | .ok cs => pure cs

  let mut covered : Array (Name × Name) := #[]
  for (_, n, ci) in constants do
    if let .thmInfo ti := ci then
      if isInversionName n then
        let observed ← coveredBy ti
        match claimedCtor ctors n with
        | .error e => fail e
        | .ok claimed =>
          if observed.size != 1 then
            fail s!"{n}: observes {observed.size} successful `stepEvent` hypotheses; expected exactly one"
          else if observed[0]! != claimed then
            fail s!"{n}: its name claims `{claimed}` but its hypothesis observes `{observed[0]!}`"
          else
            covered := covered.push (n, claimed)
  let coveredList := covered.toList.mergeSort (fun a b => a.1.toString ≤ b.1.toString)

  let theoremOf (n : Name) : Report (Option TheoremVal) := do
    match env.find? n with
    | none => fail s!"{n}: absent from the elaborated environment"; pure none
    | some (.thmInfo ti) => pure (some ti)
    | some _ => fail s!"{n}: exists but is not a theorem declaration"; pure none

  if negative then
    match coveredList.find? (fun p => ctors.contains p.2) with
    | none => fail "negative control inconclusive: no derived coverage to withhold"
    | some withheld =>
      let kept := coveredList.filter (fun p => p != withheld)
      match compareCoverage ctors kept with
      | .ok line =>
        IO.println line
        fail s!"negative control failed to fail: withheld {withheld.2} still covered"
      | .error e =>
        IO.println e
        unless (e.splitOn withheld.2.getString!).length > 1 do
          fail s!"negative control missed the withheld constructor {withheld.2}"
        IO.println s!"negative-control: withheld={withheld.2.getString!} source={withheld.1} detected=yes"
    -- The converse check, run on every bound inversion with one guard conjunct
    -- omitted from its conclusion. The unweakened conclusion must pass the same
    -- check first, so a rejection is the omitted conjunct's, not an unrelated one.
    let mut rejected := 0
    for (n, ctor) in coveredList do
      let some ti ← theoremOf n | continue
      match ← tightnessProved n ti with
      | .proved => pure ()
      | _ => fail s!"negative control inconclusive: {n} is not exact before weakening"; continue
      match ← tightnessProved n ti (weaken := true) with
      | .insufficient _ =>
        rejected := rejected + 1
        IO.println s!"negative-control: weakened={n} constructor={ctor.getString!} detected=yes"
      | .proved =>
        fail s!"negative control failed to fail: {n} still sufficient with a guard conjunct omitted"
      | .malformed e => fail s!"negative control inconclusive: {e}"
    IO.println s!"negative-control: weakened-conclusions={coveredList.length} detected={rejected}"
    -- The control of the control: a weakening that does not type-check must be
    -- reported as a malformed control, never counted as a rejection.
    let mut refused := 0
    for (n, _) in coveredList do
      let some ti ← theoremOf n | continue
      match ← tightnessProved n ti (weaken := true) (corrupt := true) with
      | .malformed _ => refused := refused + 1
      | .insufficient _ => fail s!"negative control failed to fail: an ill-typed weakening of {n} was counted as a rejection"
      | .proved => fail s!"negative control failed to fail: an ill-typed weakening of {n} was accepted"
    IO.println s!"negative-control: ill-typed-weakenings={coveredList.length} refused-as-malformed={refused}"
    return ()

  match compareCoverage ctors coveredList with
  | .ok line => IO.println line
  | .error e => IO.println e; fail "derived inversion coverage is not exact"

  for (n, claimed) in coveredList do
    let some ti ← theoremOf n | continue
    let axs ← collectAxioms n
    IO.println s!"axioms {n} = [{", ".intercalate (axs.toList.map (·.toString))}]"
    let extra := axs.toList.filter (fun a => !permittedAxioms.contains a)
    unless extra.isEmpty do
      fail s!"{n}: depends on axioms outside the permitted standard set: {" ".intercalate (extra.map (·.toString))}"
    IO.println s!"bound {n} = {claimed}"
    match ← tightnessProved n ti with
    | .proved => IO.println s!"tight {n} = ok"
    | .insufficient e | .malformed e => fail e

  let elaborated ← elaboratedTheorems env proj
  let rootNoSlash := rootCanon.dropRight 1
  let files ← leanSources (rootNoSlash ++ "/lean")
  let mut declaredTotal := 0
  let mut backedTotal := 0
  for f in files do
    match ← parsedTheoremDecls env f with
    | .error e => fail e
    | .ok declared =>
      if declared.isEmpty then continue
      declaredTotal := declaredTotal + declared.size
      let fCanonOpt ← try pure (some (← IO.FS.realPath f).toString) catch _ => pure none
      match fCanonOpt with
      | none => fail s!"{f}: cannot canonicalize source path"
      | some fCanon =>
        match proj.find? (fun m => modulePath rootNoSlash m == fCanon) with
        | none =>
          fail s!"{f} declares theorems but is not in the audited environment"
        | some m =>
          for (line, name) in declared do
            match elaborated.find? (fun p => p.1 == m && p.2.1 == line) with
            | none =>
              fail s!"{f}:{line}: `{name}` is declared in source but no theorem elaborated there"
            | some (_, _, actual) =>
              if actual.toString.endsWith name then backedTotal := backedTotal + 1
              else fail s!"{f}:{line}: source declares `{name}` but `{actual}` elaborated"
  IO.println s!"lean-theorems declared={declaredTotal} elaborated-backed={backedTotal}"
  if declaredTotal == 0 then fail "census found zero source-declared theorems"
  if backedTotal == 0 then fail "census found zero elaborated-backed theorems"
  unless declaredTotal == backedTotal do
    fail s!"source/elaborated census disagrees: declared={declaredTotal} backed={backedTotal}"

def main : TermElabM Unit := do
  let root := (← IO.getEnv "REACTIVEGAS_ROOT").getD "."
  let negative := (← IO.getEnv "REACTIVEGAS_INVERSION_NEGATIVE_CONTROL").isSome
  let (_, failures) ← (audit root negative).run #[]
  if failures.isEmpty then
    IO.println "inversion-audit: ok"
  else
    for f in failures do IO.eprintln s!"inversion-audit: {f}"
    throwError s!"inversion-audit failed with {failures.size} finding(s)"

end InversionAudit

#eval InversionAudit.main
LEANEOF
} >"$tmp/InversionAudit.lean"

if [ "$negative" -eq 1 ]; then
    export REACTIVEGAS_INVERSION_NEGATIVE_CONTROL=1
else
    unset REACTIVEGAS_INVERSION_NEGATIVE_CONTROL
fi
export REACTIVEGAS_ROOT="$root"
set +e
(cd "$lean_dir" && lake env lean "$tmp/InversionAudit.lean" >"$tmp/audit.out" 2>"$tmp/audit.err")
code=$?
set -e
cat "$tmp/audit.out" 2>/dev/null || true
cat "$tmp/audit.err" >&2 2>/dev/null || true
if grep -q 'PANIC at' "$tmp/audit.out" "$tmp/audit.err" 2>/dev/null; then
    printf '%s: gate output contains a panic string\n' "$TOOL" >&2
    exit 1
fi
if [ $code -ne 0 ]; then exit $code; fi
if ! grep -q '^inversion-audit: ok' "$tmp/audit.out" 2>/dev/null; then
    printf '%s: missing inversion-audit: ok marker\n' "$TOOL" >&2
    exit 1
fi
