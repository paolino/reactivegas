# Lean mutant ledger — renderer of lean/REACTIVEGAS-MUTANTS.md and
# lean/KELGROUPS-MUTANTS.md (M-5).
#
#   jq -r --arg half Reactivegas|KelGroups -f render.jq <bundle>
#
# Renders only from the tracked ledger and catalogue plus census facts (module
# of each identity, excluded identities, emitters). Kill evidence is the
# ledger's and catalogue's claims, which the validator has already matched
# against what Lean reported.

def cell: tostring | gsub("\\|"; "\\|") | gsub("\n"; " ");
def code: "`" + . + "`";
def inHalf($m): ($m | split(".")[0]) == $half;
def edit:
  (.before | explode) as $a | (.after | explode) as $b
  | ([range(0; [($a | length), ($b | length)] | min)] | map(select($a[.] != $b[.])) | .[0]
     // ([($a | length), ($b | length)] | min)) as $p0
  | ([range(0; ([($a | length), ($b | length)] | min) - $p0)]
     | map(select($a[($a | length) - 1 - .] != $b[($b | length) - 1 - .])) | .[0]
     // (([($a | length), ($b | length)] | min) - $p0)) as $s0
  # widen the changed span to whole identifiers, so a shared letter at either
  # end is not cut off (`designee` → `true` is not `designe` → `tru`)
  | def ident: . != null and ((. >= 48 and . <= 57) or (. >= 65 and . <= 90)
      or (. >= 97 and . <= 122) or . == 95 or . == 46 or . == 39 or . > 127);
    def at($xs; $i): if $i < 0 then null else $xs[$i] end;
    ($p0 | until(. == 0 or (at($a; . - 1) | ident | not)
                 or (($a[.] | ident) or ($b[.] | ident) | not); . - 1)) as $p
  | ($s0 | until(. == 0 or ($a[($a | length) - .] | ident | not)
                 or ((at($a; ($a | length) - . - 1) | ident) or (at($b; ($b | length) - . - 1) | ident) | not); . - 1)) as $s
  | ($a[$p:(($a | length) - $s)] | implode) as $x
  | ($b[$p:(($b | length) - $s)] | implode) as $y
  | "`" + ($x | gsub("`"; "'")) + "` → `" + ($y | gsub("`"; "'")) + "`";

. as $b
| ($b.census.declarations | map({key: .id, value: .}) | from_entries) as $decl
| ($b.census.theorems | map({key: .id, value: .}) | from_entries) as $thm
| ($b.ledger.rows | map(select(inHalf($thm[.theorem].module // "")))) as $rows
| ($b.catalogue.mutants) as $mutants
| ($mutants | map({key: .id, value: .}) | from_entries) as $mby
| ([ $b.census.vocabularies[] | select(inHalf(.module)) ]) as $vocab
| ([ $b.census.theorems[] | select(inHalf(.module)) ]) as $discovered
| ([ $b.ledger.rows[] | select(.class != "HELPER") ] | length) as $allRequired
| ([ $b.ledger.rows[] | select(.class == "KILLED") ] | length) as $allKilled
| ($rows | map(select(.class != "HELPER")) | length) as $required
| ($rows | map(select(.class == "KILLED")) | length) as $killed
| ([ $vocab[] | .constructors[] as $k
     | ([ $mutants[] | select(.decoy != true and .guard == $k.id) ]) as $gm
     | {id: $k.id, type: .type, emitters: $k.emitters, mutants: ($gm | map(.id)),
        kills: ([ $gm[] | .claimedKills[]? ] | unique),
        outcome: (if ($k.emitters | length) == 0 then "UNEMITTED"
                  elif ($gm | length) == 0 then "MISSING"
                  elif ([ $gm[] | .claimedKills[]? ] | length) == 0 then "SURVIVED"
                  else "KILLS" end)} ]) as $guards
| [
  "# \($half) mutant ledger",
  "",
  "<!-- Generated by `scripts/lean-mutants/run --write` from `lean/mutants/ledger.json`",
  "     and `lean/mutants/catalogue.json`. `just lean-mutants` fails when this file",
  "     differs from its rendering. Do not edit by hand. -->",
  "",
  "Every authored theorem of the `\($half)` modules, with the shipped production",
  "definition whose mutation makes it fail. A mutant changes one line of one",
  "production definition. It **kills** a theorem when, under it, Lean reports an",
  "error inside that theorem's own declaration **and** the mutated definition is",
  "in the theorem's statement closure (the constants its type reaches through",
  "definition bodies, never through proofs). CI re-runs every mutant on every",
  "change and fails when a claim here is not what Lean reports.",
  "",
  "- **KILLED** — the listed mutants each kill it.",
  "- **HELPER** — its statement names no production definition (computed).",
  "- **OPEN** — no admitted mutant killed it; the reason says why, and the",
  "  attempted mutants are the ones whose target is in its statement closure.",
  "",
  "## Counts, by identity",
  "",
  "| | \($half) modules | whole ledger |",
  "|---|---|---|",
  "| DISCOVERED theorem constants | \($discovered | length) | \($b.census.theorems | length) |",
  "| EXCLUDED (generated) | \([ $discovered[] | select(.class == "EXCLUDED") ] | length) | \([ $b.census.theorems[] | select(.class == "EXCLUDED") ] | length) |",
  "| HELPER | \($rows | map(select(.class == "HELPER")) | length) | \([ $b.ledger.rows[] | select(.class == "HELPER") ] | length) |",
  "| REQUIRED (authored − HELPER) | \($required) | \($allRequired) |",
  "| KILLED | \($killed) | \($allKilled) |",
  "| OPEN | \($rows | map(select(.class == "OPEN")) | length) | \([ $b.ledger.rows[] | select(.class == "OPEN") ] | length) |",
  "| refusal constructors SURVIVED | \([ $guards[] | select(.outcome == "SURVIVED") ] | length) | |",
  "| refusal constructors UNEMITTED | \([ $guards[] | select(.outcome == "UNEMITTED") ] | length) | |",
  "",
  "KILLED / REQUIRED: \($killed) / \($required) here, \($allKilled) / \($allRequired) over the whole ledger.",
  "",
  "## Theorems",
  "",
  ( $rows | group_by($thm[.theorem].module)[]
    | ("### `" + $thm[.[0].theorem].module + "`"), "",
      "| theorem | class | evidence |", "|---|---|---|",
      ( sort_by(.theorem)[]
        | "| \(.theorem | code) | \(.class) | "
          + (if .class == "KILLED" then "killed by " + (.killedBy | map(code) | join(", "))
             elif .class == "OPEN" then
               (if (.attempted | length) > 0 then "attempted " + (.attempted | map(code) | join(", ")) + ". " else "" end)
               + (.reason | cell)
             else (.reason | cell) end)
          + " |" ),
      "" ),
  "## Refusal constructors",
  "",
  "Each constructor of each refusal vocabulary (named in the mandate or discovered",
  "as the error type of a production `Except`), the production definitions that",
  "emit it (computed), and its guard mutants. **SURVIVED**: a guard mutant exists",
  "and kills nothing — an assurance gap. **UNEMITTED**: no production definition",
  "emits it, so there is no guard to mutate.",
  "",
  "| constructor | emitted by | guard mutants | kills | outcome |",
  "|---|---|---|---|---|",
  ( $guards[]
    | "| \(.id | code) | \(.emitters | map(code) | join(", ")) | \(.mutants | map(code) | join(", ")) | \(.kills | length) | \(.outcome) |" ),
  "",
  "## Mutants",
  "",
  "| mutant | target | guard | edit | line | kills |",
  "|---|---|---|---|---|---|",
  ( $mutants[] | select(inHalf($decl[.target].module // ""))
    | "| \(.id | code)\(if .decoy == true then " (decoy)" else "" end) | \(.target | code) | \(if .guard then (.guard | code) else "" end) | \(.patch | edit) | \($decl[.target].module):\(.patch.line) | \(.claimedKills // [] | length) |" ),
  "",
  "## Limits",
  "",
  "What a row here does not establish.",
  "",
  "- A kill shows the theorem constrains that one edit of that definition; it says",
  "  nothing about whether the definition is the right one for the product.",
  "- Lean admits a theorem whose proof fails, so the error stays in that theorem's",
  "  own declaration: a theorem whose proof only cites a killed theorem elaborates",
  "  and is OPEN (`masked`). Its reason names the killed theorems it rests on.",
  "- Modules that import a broken module are elaborated against it with its failed",
  "  theorems admitted. An error such a cascade placed inside an owning theorem's",
  "  declaration would be credited as a kill; nothing separates the two.",
  "- Diagnostic positions and declaration ranges are compared as Lean reports them",
  "  (line, codepoint column); multi-byte columns are not checked separately.",
  "- Which arm of a guard a refusal-constructor mutant hits is the catalogue's",
  "  label; the runner only checks that the mutated definition emits the",
  "  constructor or is reached from a definition that does.",
  "- The extent is the git-tracked Lean modules under `lean/`. CI also builds Lean",
  "  tooling packages outside it (`scripts/lake-roots/`, the Lake-roots exe the",
  "  mirror checker runs, and this runner's census and driver); a theorem authored",
  "  there would get no row and nothing would object.",
  "- Production is decided by the last component of a module's name (the rule is",
  "  printed by `scripts/lean-mutants/run --census`). A further proof-only module",
  "  whose name the rule does not list would be read as production: its",
  "  definitions would be admitted as mutant targets and refusal emitters.",
  "- The driver reproduces only the options Lake records in each module's setup;",
  "  a run where Lake passes any other Lean argument fails instead.",
  "",
  "## Excluded theorem constants",
  "",
  "Rule: \($b.census.exclusionRule).",
  "",
  "<details><summary>\([ $discovered[] | select(.class == "EXCLUDED") ] | length) identities</summary>",
  "",
  ( [ $discovered[] | select(.class == "EXCLUDED") | .id ] | sort[] | "- " + code ),
  "",
  "</details>"
] | join("\n")
